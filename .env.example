# ================================
# SUPABASE
# ================================
EXPO_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here   # backend only, never commit

# ================================
# FIREBASE
# ================================
EXPO_PUBLIC_FIREBASE_API_KEY=
EXPO_PUBLIC_FIREBASE_AUTH_DOMAIN=
EXPO_PUBLIC_FIREBASE_PROJECT_ID=
EXPO_PUBLIC_FIREBASE_STORAGE_BUCKET=
EXPO_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
EXPO_PUBLIC_FIREBASE_APP_ID=
FIREBASE_CLIENT_EMAIL=                                 # backend only
FIREBASE_PRIVATE_KEY=                                  # backend only

# ================================
# BACKEND
# ================================
BACKEND_URL=https://your-app.onrender.com
API_SECRET_KEY=generate-a-random-secret-here
NODE_ENV=development
PORT=3000

# ================================
# SMS OTP (Choose one)
# ================================
# Option A: MSG91
MSG91_AUTH_KEY=
MSG91_SENDER_ID=SOCAPP
MSG91_TEMPLATE_ID=
# Option B: 2Factor.in (simpler for MVP)
TWOFACTOR_API_KEY=

# ================================
# FEATURE FLAGS
# ================================
ENABLE_OFFLINE_MODE=false
ENABLE_WHATSAPP_NOTIFICATIONS=false
