# ============================================================
# Society App Backend — Environment Variables
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================

# -----------------------------------------------
# Server
# -----------------------------------------------

# Port the HTTP server listens on
PORT=3000

# Runtime environment: development | production | test
NODE_ENV=development

# -----------------------------------------------
# Supabase
# -----------------------------------------------

# Your Supabase project URL (e.g., https://xxxx.supabase.co)
SUPABASE_URL=https://your-project-ref.supabase.co

# Service role key — bypasses RLS, NEVER expose to frontend
# Found in: Supabase Dashboard > Project Settings > API > service_role key
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# -----------------------------------------------
# Firebase (for push notifications)
# -----------------------------------------------

# Firebase project ID (e.g., my-society-app-prod)
# Found in: Firebase Console > Project Settings > General
FIREBASE_PROJECT_ID=your-firebase-project-id

# Firebase service account client email
# Found in: Firebase Console > Project Settings > Service accounts > Generate new private key
FIREBASE_CLIENT_EMAIL=firebase-adminsdk-xxxxx@your-project.iam.gserviceaccount.com

# Firebase service account private key (include full key with newlines as \n)
# Found in the downloaded service account JSON: "private_key" field
# Escape newlines: copy the key and replace actual newlines with \n
FIREBASE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\nMIIE...\n-----END PRIVATE KEY-----\n"

# -----------------------------------------------
# CORS
# -----------------------------------------------

# Allowed frontend origin (no trailing slash)
# e.g., https://app.mygate-clone.com or http://localhost:8081 for local dev
FRONTEND_URL=http://localhost:8081

# -----------------------------------------------
# Security
# -----------------------------------------------

# Secret key for internal API-to-API calls (min 32 characters)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
API_SECRET_KEY=change_me_to_a_long_random_secret_at_least_32_chars
